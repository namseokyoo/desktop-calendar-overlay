<Window x:Class="DesktopCalendarOverlay.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add event"
        Width="460"
        Height="520"
        MinWidth="420"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OverlayBackgroundBrush}">
    <Border Margin="14"
            Padding="22"
            Background="{StaticResource OverlaySurfaceStrongBrush}"
            BorderBrush="{StaticResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <StackPanel>
            <TextBlock Text="Add event"
                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="Create a new event in the selected Google Calendar layer."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                       Margin="0,6,0,18" />

            <TextBlock Text="Calendar"
                       Foreground="{StaticResource OverlayTextSecondaryBrush}" />
            <ComboBox x:Name="CalendarLayerBox"
                      DisplayMemberPath="Name"
                      Margin="0,4,0,12" />

            <TextBlock Text="Title"
                       Foreground="{StaticResource OverlayTextSecondaryBrush}" />
            <TextBox x:Name="TitleBox"
                     Margin="0,4,0,12" />

            <TextBlock Text="Date"
                       Foreground="{StaticResource OverlayTextSecondaryBrush}" />
            <DatePicker x:Name="EventDatePicker"
                        Margin="0,4,0,12" />

            <CheckBox x:Name="AllDayCheckBox"
                      Content="All day"
                      Foreground="{StaticResource OverlayTextPrimaryBrush}"
                      Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start time"
                               Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                    <TextBox x:Name="StartTimeBox"
                             Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="End time"
                               Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                    <TextBox x:Name="EndTimeBox"
                             Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Location"
                       Foreground="{StaticResource OverlayTextSecondaryBrush}" />
            <TextBox x:Name="LocationBox"
                     Margin="0,4,0,12" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource OverlayAccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource ChromeButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="Create"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="OnCreateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
