<Window x:Class="DesktopCalendarOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Desktop Calendar Overlay"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsTopmost, Mode=TwoWay}"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <RotateTransform x:Key="RotateCollapsedTextTransform" Angle="-90" />

        <Style x:Key="ExpandedDetailVisibilityStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailPanelExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CollapsedDetailVisibilityStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailPanelExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="12"
            Padding="22"
            Opacity="{Binding OverlayOpacity}"
            Background="{StaticResource OverlayBackgroundBrush}"
            BorderBrush="{StaticResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.35"
                              ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleDragRegion"
                  Grid.ColumnSpan="2"
                  MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button Content="‹"
                            Command="{Binding PreviousMonthCommand}"
                            Style="{StaticResource ChromeButtonStyle}"
                            Width="40"
                            Margin="0,0,8,0"
                            ToolTip="Previous month" />
                    <Button Content="›"
                            Command="{Binding NextMonthCommand}"
                            Style="{StaticResource ChromeButtonStyle}"
                            Width="40"
                            ToolTip="Next month" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Desktop Calendar Overlay"
                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                               FontSize="13" />
                    <TextBlock Text="{Binding MonthTitle}"
                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                               FontSize="38"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Content="Always on top"
                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                              Foreground="{StaticResource OverlayTextPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0" />
                    <Button Content="Settings"
                            Command="{Binding OpenSettingsWindowCommand}"
                            Style="{StaticResource ChromeButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="—"
                            Style="{StaticResource ChromeButtonStyle}"
                            Width="38"
                            Margin="0,0,8,0"
                            Click="OnMinimizeClick" />
                    <Button Content="✕"
                            Style="{StaticResource ChromeButtonStyle}"
                            Width="38"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,20,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl x:Name="WeekdayHeader"
                              ItemsSource="{Binding WeekdayHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,0,4,8"
                                    Padding="8,0">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Left" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Date}"
                                    Style="{StaticResource CalendarDayButtonStyle}">
                                <Border x:Name="DayCard"
                                        MinHeight="70"
                                        Padding="8"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <TextBlock x:Name="TopLeftDateNumber"
                                                       Text="{Binding DayNumber}"
                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Text="TODAY"
                                                       Foreground="{StaticResource OverlayAccentBrush}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Margin="0,3,6,0"
                                                       DockPanel.Dock="Right"
                                                       Visibility="{Binding IsToday, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{StaticResource OverlayAccentBrush}"
                                                     DockPanel.Dock="Right"
                                                     Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </DockPanel>

                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding PreviewEvents}"
                                                      Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource OverlayAccentSoftBrush}"
                                                            CornerRadius="6"
                                                            Padding="4,1"
                                                            Margin="0,0,0,2">
                                                        <Grid>
                                                            <TextBlock x:Name="TimeFirstPreviewText"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock x:Name="EventFirstPreviewText"
                                                                       Visibility="Collapsed"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsEventFirstDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter TargetName="TimeFirstPreviewText" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="EventFirstPreviewText" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding MoreEventCount, StringFormat=+{0} more}"
                                                   Foreground="{StaticResource OverlayTextMutedBrush}"
                                                   FontSize="10"
                                                   Visibility="{Binding HasMoreEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                    <Setter TargetName="DayCard" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="DayCard" Property="Background" Value="{StaticResource OverlaySurfaceMutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="DayCard" Property="BorderBrush" Value="{StaticResource OverlayAccentBrush}" />
                                    <Setter TargetName="DayCard" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="DayCard" Property="Background" Value="{StaticResource OverlayAccentSoftBrush}" />
                                    <Setter TargetName="TopLeftDateNumber" Property="Foreground" Value="{StaticResource OverlayAccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="DayCard" Property="Background" Value="{StaticResource OverlayAccentSoftBrush}" />
                                    <Setter TargetName="DayCard" Property="BorderBrush" Value="{StaticResource OverlayAccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Width="{Binding DetailPanelWidth}"
                    Margin="0,20,0,14"
                    Padding="16"
                    Background="{StaticResource OverlaySurfaceStrongBrush}"
                    CornerRadius="24"
                    BorderBrush="{StaticResource OverlayBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Content="{Binding DetailPanelToggleText}"
                            Command="{Binding ToggleDetailPanelCommand}"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="{Binding DetailPanelToggleAccessibleText}"
                            HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="1"
                                Style="{StaticResource CollapsedDetailVisibilityStyle}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Agenda"
                                   Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   LayoutTransform="{StaticResource RotateCollapsedTextTransform}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Style="{StaticResource ExpandedDetailVisibilityStyle}">
                            <TextBlock Text="{Binding SelectedDayHeading}"
                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding SelectedDateText}"
                                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,6" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedDayEvents.Count, StringFormat={}{0} events}"
                                           Foreground="{StaticResource OverlayTextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="+ Add event"
                                        Command="{Binding OpenCreateEventWindowCommand}"
                                        Style="{StaticResource ChromeButtonStyle}"
                                        Padding="10,5" />
                            </Grid>

                            <TextBlock Text="Agenda"
                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource OverlaySurfaceBrush}"
                                                CornerRadius="14"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="TimeFirstDetailTime"
                                                           Text="{Binding TimeDisplay, Mode=OneWay}"
                                                           Foreground="{StaticResource OverlayAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="TimeFirstDetailTitle"
                                                           Text="{Binding Title, Mode=OneWay}"
                                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock x:Name="EventFirstDetailTitle"
                                                           Visibility="Collapsed"
                                                           Text="{Binding Title, Mode=OneWay}"
                                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="EventFirstDetailTime"
                                                           Visibility="Collapsed"
                                                           Text="{Binding TimeDisplay, Mode=OneWay}"
                                                           Foreground="{StaticResource OverlayAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding CalendarLayerId, StringFormat=Layer: {0}}"
                                                           Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding Location}"
                                                           Foreground="{StaticResource OverlayTextMutedBrush}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEventFirstDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="TimeFirstDetailTime" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TimeFirstDetailTitle" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="EventFirstDetailTitle" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="EventFirstDetailTime" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding StatusText}"
                       Foreground="{StaticResource OverlayTextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
