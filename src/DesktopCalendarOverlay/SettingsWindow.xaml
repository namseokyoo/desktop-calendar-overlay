<Window x:Class="DesktopCalendarOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520"
        Height="560"
        MinWidth="460"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OverlayBackgroundBrush}">
    <Border Margin="14"
            Padding="22"
            Background="{StaticResource OverlaySurfaceStrongBrush}"
            BorderBrush="{StaticResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Google account and calendar layer controls live here in v0.2. OAuth and Google Calendar API sync are intentionally disabled placeholders."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource OverlayTextSecondaryBrush}"
                           Margin="0,8,0,22" />

                <Border Padding="18"
                        Background="{StaticResource OverlaySurfaceBrush}"
                        BorderBrush="{StaticResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Google account settings"
                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Not connected"
                                   Foreground="{StaticResource OverlayAccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="Future OAuth sign-in, permission review, disconnect, and cache-clearing actions will be added here. No credentials are requested or stored in this UI spike."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />
                        <Button Content="Connect Google Calendar (disabled mock)"
                                Style="{StaticResource ChromeButtonStyle}"
                                HorizontalAlignment="Left"
                                IsEnabled="False" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{StaticResource OverlaySurfaceBrush}"
                        BorderBrush="{StaticResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Calendar layer settings"
                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Mock layer visibility is shown for layout only. Real persistence and Google-selected defaults belong to the later sync milestone."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />
                        <ItemsControl ItemsSource="{Binding CalendarLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Fill="{Binding ColorHex}"
                                                 Margin="0,0,10,0" />
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                  IsEnabled="False"
                                                  Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                        <TextBlock Text="Primary"
                                                   Foreground="{StaticResource OverlayAccentBrush}"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{StaticResource OverlaySurfaceBrush}"
                        BorderBrush="{StaticResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="Overlay behavior"
                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <CheckBox Content="Always on top"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
