<Window x:Class="DesktopCalendarOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/calendar-app-icon.png"
        Width="560"
        Height="720"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OverlayBackgroundBrush}">
    <Border Margin="14"
            Padding="22"
            Background="{DynamicResource OverlaySurfaceStrongBrush}"
            BorderBrush="{DynamicResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Google account and calendar layer controls live here. v0.3 can connect a Desktop OAuth client, read Google Calendar layers/events, and falls back to mock data when no local client JSON/token is available."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                           Margin="0,8,0,22" />

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Google account settings"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GoogleConnectionStatus}"
                                   Foreground="{DynamicResource OverlayAccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="Put the downloaded Google OAuth Desktop app JSON at this path, then click Connect. The browser consent flow stores tokens locally; no credential file is committed to the repo."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,8" />
                        <TextBlock Text="{Binding GoogleClientSecretPath}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Connect Google Calendar"
                                    Command="{Binding ConnectGoogleCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsGoogleClientSecretAvailable}"
                                    Margin="0,0,8,0" />
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectGoogleCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsGoogleConnected}"
                                    Margin="0,0,8,0" />
                            <Button Content="Refresh"
                                    Command="{Binding RefreshCalendarCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Calendar layer settings"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Google Calendar layers are loaded after connecting. Turn layers on/off here; v0.3 stores layer visibility locally and refreshes the month view."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />
                        <ItemsControl ItemsSource="{Binding CalendarLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Fill="{Binding ColorHex}"
                                                 Margin="0,0,10,0" />
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleLayerVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="{DynamicResource OverlayTextPrimaryBrush}" />
                                        <TextBlock Text="Primary"
                                                   Foreground="{DynamicResource OverlayAccentBrush}"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Display settings"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="The event list still sorts by time; this only changes whether each item reads time-first or event-first."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />

                        <TextBlock Text="Event display format"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding EventDisplayModeOptions}"
                                  SelectedItem="{Binding SelectedEventDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4,0,14" />

                        <TextBlock Text="Theme"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Overlay opacity"
                                       Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OverlayOpacityPercentText}"
                                       Foreground="{DynamicResource OverlayAccentBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="0.35"
                                Maximum="1"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="Overlay behavior"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <CheckBox Content="Always on top"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
