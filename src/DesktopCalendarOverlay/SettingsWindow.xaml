<Window x:Class="DesktopCalendarOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/calendar-app-icon.ico"
        Width="560"
        Height="720"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OverlayBackgroundBrush}">
    <Border Margin="14"
            Padding="22"
            Background="{DynamicResource OverlaySurfaceStrongBrush}"
            BorderBrush="{DynamicResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Google sync now prefers the official app OAuth client when it is packaged with the release. Local Desktop OAuth JSON remains available only as a developer fallback; otherwise the app stays in mock calendar mode."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                           Margin="0,8,0,22" />

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Google Calendar"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GoogleConnectionStatus}"
                                   Foreground="{DynamicResource OverlayAccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="{Binding GoogleConnectionDetail}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,8" />
                        <TextBlock Text="Selected OAuth client path:"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="{Binding GoogleClientSecretPath}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Official OAuth client files are injected during release packaging; token/cache state remains local and Disconnect deletes it."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Connect Google Calendar"
                                    Command="{Binding ConnectGoogleCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsGoogleClientSecretAvailable}"
                                    Margin="0,0,8,0" />
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectGoogleCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsGoogleConnected}"
                                    Margin="0,0,8,0" />
                            <Button Content="Refresh"
                                    Command="{Binding RefreshCalendarCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Calendar layers"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Turn calendars on or off and adjust their chip colors. Visibility and color choices are saved locally and applied immediately."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />
                        <ItemsControl ItemsSource="{Binding CalendarLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Button Width="28"
                                                Height="28"
                                                Padding="0"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource ChromeButtonStyle}"
                                                Click="OnLayerColorButtonClick"
                                                ToolTip="Change layer color">
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Fill="{Binding ColorHex}"
                                                     Stroke="{DynamicResource OverlayBorderBrush}"
                                                     StrokeThickness="1" />
                                        </Button>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleLayerVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="{DynamicResource OverlayTextPrimaryBrush}" />
                                        <TextBlock Text="Primary"
                                                   Foreground="{DynamicResource OverlayAccentBrush}"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Display"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Choose the event text order, theme, opacity, and event text size. Event order remains all-day first, then chronological."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}"
                                   Margin="0,6,0,12" />

                        <TextBlock Text="Event display format"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding EventDisplayModeOptions}"
                                  SelectedItem="{Binding SelectedEventDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4,0,14" />

                        <TextBlock Text="Theme"
                                   Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Overlay opacity"
                                       Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OverlayOpacityPercentText}"
                                       Foreground="{DynamicResource OverlayAccentBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="0.35"
                                Maximum="1"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,6,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date-cell event text size"
                                       Foreground="{DynamicResource OverlayTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EventListFontSizeText}"
                                       Foreground="{DynamicResource OverlayAccentBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="9"
                                Maximum="16"
                                TickFrequency="0.5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding EventListFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Background="{DynamicResource OverlaySurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="Window behavior"
                                   Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <CheckBox Content="Lock window position"
                                  IsChecked="{Binding IsPositionLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                  Margin="0,12,0,0" />
                        <CheckBox Content="Start after Windows sign-in"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="{DynamicResource OverlayTextPrimaryBrush}"
                                  Margin="0,12,0,0" />
                        <TextBlock Text="{Binding StartWithWindowsStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayTextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
